PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/real-estate
MONGO_MAX_POOL_SIZE=10
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
SLOW_REQUEST_MS=500
MONGO_QUERY_LOGS=false
MONGO_SLOW_QUERY_MS=200

# Optional: Cloudinary Cloud Storage (if omitted, uploads default to local backend/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
