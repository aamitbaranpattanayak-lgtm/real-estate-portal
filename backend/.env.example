PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/real-estate
MONGO_MAX_POOL_SIZE=10
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-frontend.example.com
SLOW_REQUEST_MS=500
# Set to true temporarily when investigating MongoDB latency.
MONGO_QUERY_LOGS=false
MONGO_SLOW_QUERY_MS=200
